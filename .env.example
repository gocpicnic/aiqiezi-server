# aiqiezi-server development configuration
# Copy to .env and change values for local development.

AIQIEZI_DATA_DIR=./data
AIQIEZI_DATABASE_URL=postgres://aiqiezi:change-me@127.0.0.1:5432/aiqiezi
AIQIEZI_AUTO_MIGRATE=false
AIQIEZI_LOG_LEVEL=info

# Runtime files (instance lock and admin socket).
# Use /run/aiqiezi in production. This local path works without root.
AIQIEZI_RUNTIME_DIR=./data/run

# Optional iroh settings
AIQIEZI_RELAY_URL=
AIQIEZI_RELAY_TOKEN=
AIQIEZI_DNS_SERVER=
AIQIEZI_BIND_ADDR=
