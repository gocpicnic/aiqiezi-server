# Production deployment configuration for Docker Compose.
# Copy this file to /mnt/data/aiqiezi/deploy/.env and replace all secrets.
# Never commit the populated .env file.

AIQIEZI_IMAGE=ghcr.io/gocpicnic/aiqiezi-server
# Use the exact tag printed by make docker-push/docker-save.
AIQIEZI_TAG=v0.1.0-YYYYMMDDHHMMSS

AIQIEZI_UID=1000
AIQIEZI_GID=1000
AIQIEZI_LOG_LEVEL=info

# Keep this URL password URL-safe if it contains special characters.
AIQIEZI_DATABASE_URL=postgres://aiqiezi:change-me@127.0.0.1:5432/aiqiezi

# Optional iroh settings.
AIQIEZI_RELAY_URL=
AIQIEZI_RELAY_TOKEN=
AIQIEZI_DNS_SERVER=

POSTGRES_DB=aiqiezi
POSTGRES_USER=aiqiezi
POSTGRES_PASSWORD=change-me
# If this changes, update the port in AIQIEZI_DATABASE_URL too.
POSTGRES_PORT=5432
